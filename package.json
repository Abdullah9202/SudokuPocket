{
  "name": "sudokupocket",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "setup": "npx expo install react react-native react-native-safe-area-context @react-native-async-storage/async-storage expo-constants expo-status-bar expo-splash-screen && npx expo install --fix",
    "start": "expo start",
    "doctor": "npx expo-doctor",
    "build:aab": "eas build --platform android --profile production",
    "build:apk": "eas build --platform android --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.16",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
